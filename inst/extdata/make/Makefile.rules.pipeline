# ===============================================
# PIPELINE SETTINGS
# ===============================================
MAKEFLAGS += --output-sync

METHYLATION_SCALE ?= beta
GENCODE_HUB ?= FALSE
optional_text_arg = $(if $(filter NULL null,$(strip $(1))),NULL,$(if $(strip $(1)),'$(strip $(1))',NULL))
MODEL_CONFIG_ERROR = The dnaEPICO Makefile configuration has changed. Please update your Makefile.
require_model_config = $(if $(filter undefined,$(origin $(1))),$(error $(MODEL_CONFIG_ERROR)),$(if $(strip $($(1))),,$(error $(MODEL_CONFIG_ERROR))))
LME_CORRELATION_VAR ?= NULL
PROBE_EXCLUSION_FILE ?= $(CROSS_REACTIVE_FILE)
REMOVE_SEX_MISMATCH ?= FALSE
PROBE_EXCLUSION_ID_COLUMN ?= $(CROSS_REACTIVE_ID_COLUMN)
USE_EPICV2_MANIFEST ?= FALSE
EPICV2_MANIFEST_CH_WGBS_EVIDENCE ?= TRUE
EPICV2_MANIFEST_CH_BLAT ?= TRUE
EPICV2_MANIFEST_MISSING_POS ?= TRUE
EPICV2_MANIFEST_MISMATCH_POS ?= FALSE
SEP_TYPE_ARG ?= $(call optional_text_arg,$(SEP_TYPE))
PRS_MAP_ARG ?= $(call optional_text_arg,$(PRS_MAP))
R_DIR_ARG ?= $(call optional_text_arg,$(R_DIR))
PROBE_EXCLUSION_ID_COLUMN_ARG ?= $(call optional_text_arg,$(PROBE_EXCLUSION_ID_COLUMN))
INTERACTION_GLM_ARG ?= $(call optional_text_arg,$(INTERACTION_GLM))
INTERACTION_LME_ARG ?= $(call optional_text_arg,$(INTERACTION_LME))
VENND_GLM_PHENOTYPES_ARG ?= $(call optional_text_arg,$(VENND_GLM_PHENOTYPES))
VENND_GLM_LABELS_ARG ?= $(call optional_text_arg,$(VENND_GLM_LABELS))
VENND_GLM_OMNIBUS_PHENOTYPES_ARG ?= $(call optional_text_arg,$(VENND_GLM_OMNIBUS_PHENOTYPES))
VENND_GLM_OMNIBUS_LABELS_ARG ?= $(call optional_text_arg,$(VENND_GLM_OMNIBUS_LABELS))
VENND_LME_PHENOTYPES_ARG ?= $(call optional_text_arg,$(VENND_LME_PHENOTYPES))
VENND_LME_LABELS_ARG ?= $(call optional_text_arg,$(VENND_LME_LABELS))
VENND_LME_OMNIBUS_PHENOTYPES_ARG ?= $(call optional_text_arg,$(VENND_LME_OMNIBUS_PHENOTYPES))
VENND_LME_OMNIBUS_LABELS_ARG ?= $(call optional_text_arg,$(VENND_LME_OMNIBUS_LABELS))
GLM_VENND_PHENOTYPES_RUNTIME_ARG = $(VENND_GLM_PHENOTYPES_ARG)
GLM_VENND_LABELS_RUNTIME_ARG = $(VENND_GLM_LABELS_ARG)
GLM_VENND_OMNIBUS_PHENOTYPES_RUNTIME_ARG = $(VENND_GLM_OMNIBUS_PHENOTYPES_ARG)
GLM_VENND_OMNIBUS_LABELS_RUNTIME_ARG = $(VENND_GLM_OMNIBUS_LABELS_ARG)
LME_VENND_PHENOTYPES_RUNTIME_ARG = $(VENND_LME_PHENOTYPES_ARG)
LME_VENND_LABELS_RUNTIME_ARG = $(VENND_LME_LABELS_ARG)
LME_VENND_OMNIBUS_PHENOTYPES_RUNTIME_ARG = $(VENND_LME_OMNIBUS_PHENOTYPES_ARG)
LME_VENND_OMNIBUS_LABELS_RUNTIME_ARG = $(VENND_LME_OMNIBUS_LABELS_ARG)
LME_CORRELATION_VAR_ARG ?= $(call optional_text_arg,$(LME_CORRELATION_VAR))
COMBINE_TIMEPOINTS_ARG ?= $(call optional_text_arg,$(COMBINE_TIMEPOINTS))
empty :=
space := $(empty) $(empty)
comma := ,
TIMEPOINT_LIST = $(strip $(subst $(comma), ,$(TIMEPOINTS)))
COMBINE_TIMEPOINTS_ENABLED = $(strip $(filter-out NULL null,$(COMBINE_TIMEPOINTS)))
COMBINE_TIMEPOINT_LIST = $(if $(COMBINE_TIMEPOINTS_ENABLED),$(strip $(subst $(comma), ,$(COMBINE_TIMEPOINTS))),)
TIMEPOINT_SUFFIXES = $(addprefix T,$(TIMEPOINT_LIST))
COMBINED_TIMEPOINT_SUFFIX = $(if $(COMBINE_TIMEPOINT_LIST),T$(subst $(space),T,$(COMBINE_TIMEPOINT_LIST)),)
GLM_TIMEPOINT ?= $(firstword $(TIMEPOINT_LIST))
GLM_TIMEPOINT_SUFFIX = T$(GLM_TIMEPOINT)
ifeq ($(METHYLATION_SCALE),beta)
PHENO_METHYLATION_PREFIX = phenoB
else ifeq ($(METHYLATION_SCALE),m)
PHENO_METHYLATION_PREFIX = phenoM
else ifeq ($(METHYLATION_SCALE),cn)
PHENO_METHYLATION_PREFIX = phenoCN
else
$(error METHYLATION_SCALE must be one of beta, m, cn)
endif
TIMEPOINT_PHENO_TARGETS = $(addprefix $(DATA_DIR)/$(MODEL)/$(STEP3)/pheno,$(addsuffix .csv,$(TIMEPOINT_SUFFIXES)))
TIMEPOINT_PHENO_METHYLATION_TARGETS = $(addprefix $(RDATA_DIR)/$(MODEL)/$(STEP3)/$(MERGE_DIR)/$(PHENO_METHYLATION_PREFIX),$(addsuffix .RData,$(TIMEPOINT_SUFFIXES)))
COMBINED_PHENO_TARGET = $(if $(COMBINED_TIMEPOINT_SUFFIX),$(DATA_DIR)/$(MODEL)/$(STEP3)/pheno$(COMBINED_TIMEPOINT_SUFFIX).csv,)
GLM_PHENO_METHYLATION = $(RDATA_DIR)/$(MODEL)/$(STEP3)/$(MERGE_DIR)/$(PHENO_METHYLATION_PREFIX)$(GLM_TIMEPOINT_SUFFIX).RData
COMBINED_PHENO_METHYLATION = $(if $(COMBINED_TIMEPOINT_SUFFIX),$(RDATA_DIR)/$(MODEL)/$(STEP3)/$(MERGE_DIR)/$(PHENO_METHYLATION_PREFIX)$(COMBINED_TIMEPOINT_SUFFIX).RData,)
ifneq ($(strip $(SEED)),)
SET_SEED_EXPR = set.seed($(SEED));
else
SET_SEED_EXPR =
endif
PHENO_LC = $(DATA_DIR)/$(MODEL)/$(STEP1)/phenoLC.csv
SVA_MARKER = $(DATA_DIR)/$(MODEL)/$(STEP2)/.sva_complete
GLM_REPORT_ASSET_DIR = $(STEP6)/$(MODEL)/assets/results/glm_results
LME_REPORT_ASSET_DIR = $(STEP6)/$(MODEL)/assets/results/lme_results
GLM_WORKBOOK = $(DATA_DIR)/$(MODEL)/$(STEP4)/annotatedGLM.xlsx
LME_WORKBOOK = $(DATA_DIR)/$(MODEL)/$(STEP5)/annotatedLME.xlsx
GLM_REPORT_SIDECARS = \
	$(GLM_REPORT_ASSET_DIR)/annotatedGLM.tsv.gz \
	$(GLM_REPORT_ASSET_DIR)/annotatedGLM.report.tsv \
	$(GLM_REPORT_ASSET_DIR)/annotatedGLM.dictionary.tsv \
	$(GLM_REPORT_ASSET_DIR)/annotatedGLM.metadata.tsv
LME_REPORT_SIDECARS = \
	$(LME_REPORT_ASSET_DIR)/annotatedLME.tsv.gz \
	$(LME_REPORT_ASSET_DIR)/annotatedLME.report.tsv \
	$(LME_REPORT_ASSET_DIR)/annotatedLME.dictionary.tsv \
	$(LME_REPORT_ASSET_DIR)/annotatedLME.metadata.tsv
GLM_OUTPUTS = $(GLM_WORKBOOK) $(GLM_REPORT_SIDECARS)
LME_OUTPUTS = $(LME_WORKBOOK) $(LME_REPORT_SIDECARS)

# ===============================================
# Run the complete pipeline for all models
# ===============================================
models:
	@echo "Running models in parallel: $(MODELS)"
	@$(MAKE) -j $(words $(MODELS)) $(addprefix run-, $(MODELS))

run-%: FORCE
	@echo ">>> Starting full pipeline for: $*"
	@$(MAKE) -j1 all MODEL=$*
	@echo "<<< Finished full pipeline for: $*"

default: all

all: report-all
	
# ===============================================
# Group target: f3 (Steps 1 to 3)
# ===============================================
.PHONY: f3
FIRST3 = \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/m_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/cn_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(SVA_MARKER) \
	$(PHENO_LC) \
	$(STEP3_OUTPUTS)

f3: report-f3

# ===============================================
# Run f3 (Steps 1 to 3) for all models in parallel
# ===============================================
f3_models:
	@echo "Running f3 (Steps 1-3) in parallel: $(MODELS)"
	@$(MAKE) -j $(words $(MODELS)) $(addprefix runf3-, $(MODELS))

runf3-%: FORCE
	@echo ">>> Starting f3 for: $*"
	@$(MAKE) -j1 f3 MODEL=$*
	@echo "<<< Finished f3 for: $*"

# ===============================================
# Group target: f4 (Steps 1 to 4)
# ===============================================
.PHONY: f4
FIRST4 = \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/m_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/cn_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(SVA_MARKER) \
	$(PHENO_LC) \
	$(STEP3_OUTPUTS) \
	$(GLM_OUTPUTS)

f4: report-f4

# ===============================================
# Run f4 (Steps 1 to 4) for all models in parallel
# ===============================================
f4_models:
	@echo "Running f4 (Steps 1-4) in parallel: $(MODELS)"
	@$(MAKE) -j $(words $(MODELS)) $(addprefix runf4-, $(MODELS))

runf4-%: FORCE
	@echo ">>> Starting f4 for: $*"
	@$(MAKE) -j1 f4 MODEL=$*
	@echo "<<< Finished f4 for: $*"

# ===============================================
# Group target: f3lme (Steps 1 to 3 + LME)
# ===============================================
.PHONY: f3lme
F3LME = \
  $(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/m_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/cn_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(SVA_MARKER) \
	$(PHENO_LC) \
	$(STEP3_OUTPUTS) \
	$(LME_OUTPUTS)

f3lme: report-f3lme

# ===============================================
# Run f3lme (Steps 1 to 3 + LME) for all models in parallel
# ===============================================

f3lme_models:
	@echo "Running f3lme (Steps 1-3 + LME) in parallel: $(MODELS)"
	@$(MAKE) -j $(words $(MODELS)) $(addprefix runf3lme-, $(MODELS))

runf3lme-%: FORCE
	@echo ">>> Starting f3lme for: $*"
	@$(MAKE) -j1 f3lme MODEL=$*
	@echo "<<< Finished f3lme for: $*"

# =================================================================================================================================
# Step 1: Minfi Preprocessing
# =================================================================================================================================
MODEL_LOG_DIR = $(LOGS_DIR)/$(MODEL)
STEP1_PRIMARY = $(RDATA_DIR)/$(MODEL)/$(STEP1)/$(OBJ_DIR)/RGSet.RData
STEP1_DERIVED = \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/m_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/cn_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(QC_DIR)/detP_RGSet.RData \
	$(PHENO_LC)

step1:
	@echo "Running Step 1 for $(MODEL)"
	@$(MAKE) -j1 \
	  $(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/m_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	  $(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	  $(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/cn_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	  $(RDATA_DIR)/$(MODEL)/$(STEP1)/$(QC_DIR)/detP_RGSet.RData \
	  $(PHENO_LC) \
	  MODEL=$(MODEL)

$(STEP1_PRIMARY): $(PHENO_FILE)
	@Rscript -e "$(SET_SEED_EXPR) suppressPackageStartupMessages(library(dnaEPICO)); invisible(preprocessingMinfiEwasWater( \
	  phenoFile = '$(PHENO_FILE)', \
	  sepType = $(SEP_TYPE_ARG), \
	  idatFolder = '$(DATA_DIR)/$(STEP1)/$(IDAT_DIR)/', \
	  outputLogs = '$(MODEL_LOG_DIR)', \
	  nSamples = $(N_SAMPLES), \
	  SampleID = '$(SAMPLE_ID)', \
	  arrayType = '$(ARRAY_TYPE)', \
	  annotationVersion = '$(ANNOTATION_VERSION)', \
	  idatForce = $(IDAT_FORCE), \
	  scriptLabel = '$(MODEL)/$(STEP1)', \
	  baseDataFolder = '$(RDATA_DIR)', \
	  figureBaseDir = '$(FIGURES_DIR)', \
	  tiffWidth = $(TIFF_WIDTH), \
	  tiffHeight = $(TIFF_HEIGHT), \
	  tiffRes = $(TIFF_RES), \
	  qcCutoff = $(QC_CUTOFF), \
	  detPtype = '$(DET_PTYPE)', \
	  detPThreshold = $(DET_PTHRESHOLD), \
	  sexColumn = '$(SEX_COLUMN)', \
	  removeSexMismatch = $(REMOVE_SEX_MISMATCH), \
	  pvalThreshold = $(PVAL_THRESHOLD), \
	  chrToRemove = '$(CHR_TO_REMOVE)', \
	  snpsToRemove = '$(SNPS_TO_REMOVE)', \
	  probeExclusionPath = '$(PROBE_EXCLUSION_FILE)', \
	  probeExclusionIdColumn = $(PROBE_EXCLUSION_ID_COLUMN_ARG), \
	  useEpicV2Manifest = $(USE_EPICV2_MANIFEST), \
	  epicV2ManifestFlags = c( \
	    CH_WGBS_evidence = $(EPICV2_MANIFEST_CH_WGBS_EVIDENCE), \
	    CH_BLAT = $(EPICV2_MANIFEST_CH_BLAT), \
	    MissingPos = $(EPICV2_MANIFEST_MISSING_POS), \
	    MismatchPos = $(EPICV2_MANIFEST_MISMATCH_POS)), \
	  mafThreshold = $(MAF_THRESHOLD), \
	  plotGroupVar = '$(PLOT_GROUP_VAR)', \
	  lcRef = '$(LC_REF)', \
	  phenoOrder = '$(PHENO_ORDER)', \
	  lcPhenoDir = '$(DATA_DIR)/$(MODEL)/$(STEP1)', \
	  logs = TRUE, \
	  saveOutputs = TRUE ))"

$(STEP1_DERIVED): $(STEP1_PRIMARY)
	@Rscript -e "target <- commandArgs(trailingOnly = TRUE)[[1L]]; if (!file.exists(target)) stop('Step 1 did not create expected output: ', target, call. = FALSE)" "$@"

# =================================================================================================================================
# Step 2: Surrogate Variable Analysis
# =================================================================================================================================
step2:
	@echo "Running Step 2 for $(MODEL)"
	@$(MAKE) -j1 $(SVA_MARKER) MODEL=$(MODEL)

$(SVA_MARKER): $(PHENO_LC) $(RDATA_DIR)/$(MODEL)/$(STEP1)/$(OBJ_DIR)/RGSet.RData
	@Rscript -e "if (file.exists('$(SVA_MARKER)')) unlink('$(SVA_MARKER)')"
	@Rscript -e "suppressPackageStartupMessages(library(dnaEPICO)); invisible(svaEnmix( \
	  phenoFile = '$(PHENO_LC)', \
	  rgsetData = '$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(OBJ_DIR)/RGSet.RData', \
	  sepType = $(SEP_TYPE_ARG), \
	  outputLogs = '$(MODEL_LOG_DIR)', \
	  nSamples = $(N_SAMPLES), \
	  SampleID = '$(SAMPLE_ID)', \
	  arrayType = '$(ARRAY_TYPE)', \
  	  annotationVersion = '$(ANNOTATION_VERSION)', \
  	  SentrixIDColumn = '$(SENTRIX_ID_COLUMN)', \
	  SentrixPositionColumn = '$(SENTRIX_POSITION_COLUMN)', \
	  ctrlSvaPercVar = $(CTRL_SVA_PERC_VAR), \
  	  ctrlSvaFlag = $(CTRL_SVA_FLAG), \
	  scriptLabel = '$(MODEL)/$(STEP2)', \
	  figureBaseDir = '$(FIGURES_DIR)', \
	  dataBaseDir = '$(DATA_DIR)', \
	  rBaseDir = '$(RDATA_DIR)', \
	  tiffWidth = $(TIFF_WIDTH), \
	  tiffHeight = $(TIFF_HEIGHT), \
	  tiffRes = $(TIFF_RES), \
	  logs = TRUE, \
	  saveOutputs = TRUE ))"
	@Rscript -e "if (!file.exists('$(PHENO_LC)')) stop('SVA phenotype file is missing.', call. = FALSE); dir.create(dirname('$(SVA_MARKER)'), recursive = TRUE, showWarnings = FALSE); if (!file.create('$(SVA_MARKER)')) stop('Could not create the SVA completion marker.', call. = FALSE)"

# =================================================================================================================================
# Step 3: Prepare phenotype and methylation data
# =================================================================================================================================
STEP3_PRIMARY = $(if $(COMBINED_PHENO_METHYLATION),$(COMBINED_PHENO_METHYLATION),$(firstword $(TIMEPOINT_PHENO_METHYLATION_TARGETS)))
STEP3_OUTPUTS = $(sort \
	$(TIMEPOINT_PHENO_TARGETS) \
	$(TIMEPOINT_PHENO_METHYLATION_TARGETS) \
	$(COMBINED_PHENO_TARGET) \
	$(COMBINED_PHENO_METHYLATION))
STEP3_DERIVED = $(filter-out $(STEP3_PRIMARY),$(STEP3_OUTPUTS))

step3:
	@echo "Running Step 3 for $(MODEL)"
	@$(MAKE) -j1 $(STEP3_OUTPUTS) MODEL=$(MODEL)

$(STEP3_PRIMARY): $(SVA_MARKER) $(PHENO_LC) \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/m_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData \
	$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/cn_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData
	@Rscript -e "suppressPackageStartupMessages(library(dnaEPICO)); invisible(preprocessingPheno( \
	  phenoFile = '$(PHENO_LC)', \
	  sepType = $(SEP_TYPE_ARG), \
	  betaPath = '$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData', \
	  mPath = '$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/m_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData', \
	  cnPath = '$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/cn_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData', \
	  SampleID = '$(SAMPLE_ID)', \
	  timeVar = '$(TIME_VAR)', \
	  timepoints = '$(TIMEPOINTS)', \
	  combineTimepoints = $(COMBINE_TIMEPOINTS_ARG), \
	  methylationScale = '$(METHYLATION_SCALE)', \
	  outputPheno = '$(DATA_DIR)/$(MODEL)/$(STEP3)', \
	  outputRData = '$(RDATA_DIR)/$(MODEL)/$(STEP3)/$(METRICS_DIR)', \
	  outputRDataMerge = '$(RDATA_DIR)/$(MODEL)/$(STEP3)/$(MERGE_DIR)', \
	  outputLogs = '$(MODEL_LOG_DIR)', \
	  sexColumn = '$(SEX_COLUMN)', \
	  outputDir = '$(DATA_DIR)/$(MODEL)/$(STEP3)', \
	  logs = TRUE, \
	  saveOutputs = TRUE ))"  

$(STEP3_DERIVED): $(STEP3_PRIMARY)
	@Rscript -e "target <- commandArgs(trailingOnly = TRUE)[[1L]]; if (!file.exists(target)) stop('Step 3 did not create expected output: ', target, call. = FALSE)" "$@"
	  
# =================================================================================================================================
# Step 4: methylationGLM
# =================================================================================================================================
.PHONY: validate-glm-config
validate-glm-config:
	@Rscript -e "invisible(NULL)" $(call require_model_config,COVARIATES_GLM) $(call require_model_config,FACTOR_VARS_GLM) $(call require_model_config,SCALE_VARS_GLM) $(call require_model_config,GLM_OMNIBUS_TEST)

$(GLM_OUTPUTS) &: $(GLM_PHENO_METHYLATION) | validate-glm-config
	@Rscript -e "suppressPackageStartupMessages(library(dnaEPICO)); invisible(methylationGLM( \
	  inputPheno = '$(GLM_PHENO_METHYLATION)', \
	  outputLogs = '$(MODEL_LOG_DIR)', \
	  outputRData = '$(RDATA_DIR)/$(MODEL)/$(STEP4)/$(MODEL_DIR)', \
	  outputPlots = '$(FIGURES_DIR)/$(MODEL)/$(STEP4)/', \
	  phenotypes = '$(PHENOTYPES_GLM)', \
	  covariates = $(call optional_text_arg,$(COVARIATES_GLM)), \
	  factorVars = $(call optional_text_arg,$(FACTOR_VARS_GLM)), \
	  scaleVars = $(call optional_text_arg,$(SCALE_VARS_GLM)), \
	  cpgPrefix = '$(CPG_PREFIX)', \
	  cpgLimit = $(CPG_LIMIT), \
	  methylationScale = '$(METHYLATION_SCALE)', \
	  nCores = $(N_CORES), \
	  plotWidth = $(TIFF_WIDTH), \
	  plotHeight = $(TIFF_HEIGHT), \
	  plotDPI = $(TIFF_RES), \
	  interactionTerm = $(INTERACTION_GLM_ARG), \
	  omnibusTest = $(GLM_OMNIBUS_TEST), \
	  vennDPhenotypes = $(GLM_VENND_PHENOTYPES_RUNTIME_ARG), \
	  vennDLabels = $(GLM_VENND_LABELS_RUNTIME_ARG), \
	  vennDOmnibusPhenotypes = $(GLM_VENND_OMNIBUS_PHENOTYPES_RUNTIME_ARG), \
	  vennDOmnibusLabels = $(GLM_VENND_OMNIBUS_LABELS_RUNTIME_ARG), \
	  libPath = $(R_DIR_ARG), \
	  glmLibs = '$(GLM_LIBS)', \
	  prsMap = $(PRS_MAP_ARG), \
	  summaryPval = $(SUMMARY_PVAL), \
	  summaryResidualSD = $(SUMMARY_RESIDUAL_SD), \
	  saveSignificantCpGs = $(SAVE_SIGNIFICANT_CPGS), \
	  significantCpGDir = '$(RESULTS_DIR)/$(MODEL)/$(CPG_DIR)/$(STEP4)', \
	  significantCpGPval = $(SIGNIFICANT_CPG_PVAL), \
	  saveTxtSummaries = $(SAVE_TXT_SUMMARIES), \
	  chunkSize = $(CHUNK_SIZE), \
	  summaryTxtDir = '$(RESULTS_DIR)/$(MODEL)/$(SUMMARY_DIR)/$(STEP4)', \
	  fdrThreshold = $(FDR_THRESHOLD), \
	  padjmethod = '$(PADJ_METHOD)', \
	  annotationPackage = '$(ANNOTATION_PACKAGE)', \
	  annotationCols = '$(ANNOTATION_COLS)', \
	  gencodeHub = $(GENCODE_HUB), \
	  annotatedGLMOut = '$(DATA_DIR)/$(MODEL)/$(STEP4)', \
	  reportAssetsDir = '$(GLM_REPORT_ASSET_DIR)', \
	  resumeFromSummary = $(RESUME_FROM_SUMMARY), \
	  logs = TRUE, \
	  saveOutputs = TRUE )) "

# =================================================================================================================================
# Step 5: methylationLME
# =================================================================================================================================
.PHONY: validate-lme-config
validate-lme-config:
	@Rscript -e "if (!$(if $(COMBINED_PHENO_METHYLATION),TRUE,FALSE)) stop('COMBINE_TIMEPOINTS must contain at least one timepoint.', call. = FALSE)"
	@Rscript -e "invisible(NULL)" $(call require_model_config,COVARIATES_LME) $(call require_model_config,FACTOR_VARS_LME) $(call require_model_config,SCALE_VARS_LME)

$(LME_OUTPUTS) &: $(COMBINED_PHENO_METHYLATION) | validate-lme-config
	@Rscript -e "suppressPackageStartupMessages(library(dnaEPICO)); invisible(methylationLME( \
	  inputPheno = '$(COMBINED_PHENO_METHYLATION)', \
	  outputLogs = '$(MODEL_LOG_DIR)', \
	  outputRData = '$(RDATA_DIR)/$(MODEL)/$(STEP5)/$(MODEL_DIR)', \
	  outputPlots = '$(FIGURES_DIR)/$(MODEL)/$(STEP5)', \
	  personVar = '$(PERSON_VAR)', \
	  timeVar = '$(TIME_VAR)', \
	  phenotypes = '$(PHENOTYPES_LME)', \
	  covariates = $(call optional_text_arg,$(COVARIATES_LME)), \
	  factorVars = $(call optional_text_arg,$(FACTOR_VARS_LME)), \
	  scaleVars = $(call optional_text_arg,$(SCALE_VARS_LME)), \
	  lmeLibs = '$(LME_LIBS)', \
	  correlationStructure = '$(LME_CORRELATION_STRUCTURE)', \
	  correlationVar = $(LME_CORRELATION_VAR_ARG), \
	  prsMap = $(PRS_MAP_ARG), \
	  libPath = $(R_DIR_ARG), \
	  cpgPrefix = '$(CPG_PREFIX)', \
	  cpgLimit = $(CPG_LIMIT), \
	  methylationScale = '$(METHYLATION_SCALE)', \
	  nCores = $(N_CORES), \
	  summaryPval = $(SUMMARY_PVAL), \
	  plotWidth = $(TIFF_WIDTH), \
	  plotHeight = $(TIFF_HEIGHT), \
	  plotDPI = $(TIFF_RES), \
	  interactionTerm = $(INTERACTION_LME_ARG), \
	  omnibusTest = $(LME_OMNIBUS_TEST), \
	  omnibusDdf = '$(LME_OMNIBUS_DDF)', \
	  vennDPhenotypes = $(LME_VENND_PHENOTYPES_RUNTIME_ARG), \
	  vennDLabels = $(LME_VENND_LABELS_RUNTIME_ARG), \
	  vennDOmnibusPhenotypes = $(LME_VENND_OMNIBUS_PHENOTYPES_RUNTIME_ARG), \
	  vennDOmnibusLabels = $(LME_VENND_OMNIBUS_LABELS_RUNTIME_ARG), \
	  saveSignificantInteractions = $(SAVE_SIGNIFICANT_INTERACTIONS), \
	  significantInteractionDir = '$(RESULTS_DIR)/$(MODEL)/$(CPG_DIR)/$(STEP5)', \
	  significantInteractionPval = $(SIGNIFICANT_INTERACTION_PVAL), \
	  saveTxtSummaries = $(SAVE_TXT_SUMMARIES), \
	  chunkSize = $(CHUNK_SIZE), \
	  summaryTxtDir = '$(RESULTS_DIR)/$(MODEL)/$(SUMMARY_DIR)/$(STEP5)', \
	  fdrThreshold = $(FDR_THRESHOLD), \
	  padjmethod = '$(PADJ_METHOD)', \
	  annotationPackage = '$(ANNOTATION_PACKAGE)', \
	  annotationCols = '$(ANNOTATION_COLS)', \
	  gencodeHub = $(GENCODE_HUB), \
	  annotatedLMEOut = '$(DATA_DIR)/$(MODEL)/$(STEP5)', \
	  reportAssetsDir = '$(LME_REPORT_ASSET_DIR)', \
	  resumeFromSummary = $(RESUME_FROM_SUMMARY), \
	  logs = TRUE, \
	  saveOutputs = TRUE ))"

# =================================================================================================================================
# Step 6: Final Report
# =================================================================================================================================
report-f3: REPORT_MODEL_SECTIONS_ARG = character(0)
report-f4: REPORT_MODEL_SECTIONS_ARG = 'glm'
report-f3lme: REPORT_MODEL_SECTIONS_ARG = 'lme'
report-all: REPORT_MODEL_SECTIONS_ARG = c('glm','lme')

report-f3: $(FIRST3)
report-f4: $(FIRST4)
report-f3lme: $(F3LME)
report-all: $(FIRST4) $(LME_OUTPUTS)

report-f3 report-f4 report-f3lme report-all:
	@Rscript -e "dirs <- commandArgs(trailingOnly = TRUE); ok <- vapply(dirs, dir.create, logical(1), recursive = TRUE, showWarnings = FALSE); if (!all(ok | dir.exists(dirs))) stop('Could not create report directories.', call. = FALSE)" "$(STEP6)/$(MODEL)" "$(MODEL_LOG_DIR)"
	@Rscript -e "suppressPackageStartupMessages(library(dnaEPICO)); result <- dnamReport( \
	  outputDir = '$(STEP6)/$(MODEL)', \
	  phenoTab = '$(PHENO_LC)', \
	  enmixTab = '$(FIGURES_DIR)/$(MODEL)/$(STEP1)/$(ENMIX_DIR)', \
	  qcTab = '$(FIGURES_DIR)/$(MODEL)/$(STEP1)/$(QC_DIR)', \
	  svaTab = '$(FIGURES_DIR)/$(MODEL)/$(STEP2)', \
	  metricTab = '$(FIGURES_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)', \
	  glmTab = '$(DATA_DIR)/$(MODEL)/$(STEP4)/annotatedGLM.xlsx', \
	  lmeTab = '$(DATA_DIR)/$(MODEL)/$(STEP5)/annotatedLME.xlsx', \
	  modelSections = $(REPORT_MODEL_SECTIONS_ARG), \
	  detPPath = '$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(QC_DIR)/detP_RGSet.RData', \
	  detPThreshold = '$(PVAL_THRESHOLD)', \
	  verbose = FALSE, \
	  logs = TRUE, \
	  logTab = '$(MODEL_LOG_DIR)' ); \
	  if (!identical(result[['status']], 'rendered') || !file.exists(result[['outputFile']])) { \
	    stop('Report rendering failed. See $(MODEL_LOG_DIR)/log_dnamReport.txt for details.', call. = FALSE); \
	  }"
	@echo "Report built: $(STEP6)/$(MODEL)/docs/index.html"

# =================================================================================================================================
# Remove outputs
# =================================================================================================================================
clean_models:
	@echo "===== Cleaning all models ====="
	@Rscript -e "models <- trimws(commandArgs(trailingOnly = TRUE)[[1L]]); if (!nzchar(models)) stop('MODELS must contain at least one model directory name.', call. = FALSE)" "$(MODELS)"
	@$(MAKE) -j1 $(addprefix clean-model-,$(MODELS))
	@Rscript -e "args <- commandArgs(trailingOnly = TRUE); models <- strsplit(trimws(args[[1L]]), '[[:space:]]+')[[1L]]; roots <- args[2:7]; targets <- unlist(lapply(models, function(model) file.path(roots, model)), use.names = FALSE); remaining <- unique(targets[file.exists(targets)]); if (length(remaining)) stop('Cleanup incomplete because outputs were recreated while clean_models was running:\n  - ', paste(remaining, collapse = '\n  - '), call. = FALSE)" "$(MODELS)" "$(DATA_DIR)" "$(RDATA_DIR)" "$(STEP6)" "$(LOGS_DIR)" "$(FIGURES_DIR)" "$(RESULTS_DIR)"
	@echo "Cleanup completed for all models. Kept $(DATA_DIR)/$(STEP1)/."

clean-model-%: FORCE
	@$(MAKE) -j1 clean MODEL=$*

clean:
ifeq ($(MODEL),all)
	@$(MAKE) -j1 clean_models
else
	@echo "Cleaning outputs for: $(MODEL)"
	@Rscript -e "args <- commandArgs(trailingOnly = TRUE); model <- trimws(args[[1L]]); backslash <- intToUtf8(92L); if (!nzchar(model) || model %in% c('.', '..', 'all') || grepl('/', model, fixed = TRUE) || grepl(backslash, model, fixed = TRUE) || basename(model) != model) stop('MODEL must be a single safe directory name.', call. = FALSE); workspace <- normalizePath(args[[2L]], winslash = '/', mustWork = TRUE); roots <- stats::setNames(args[3:8], c('data', 'rData', 'reports', 'logs', 'figures', 'results')); roots <- vapply(roots, normalizePath, character(1), winslash = '/', mustWork = FALSE); compare_path <- function(path) if (identical(getElement(.Platform, 'OS.type'), 'windows')) tolower(path) else path; trim_path <- function(path) { while (nchar(path) > 1L && endsWith(path, '/')) path <- substr(path, 1L, nchar(path) - 1L); path }; workspace_compare <- trim_path(compare_path(workspace)); root_compare <- vapply(compare_path(roots), trim_path, character(1)); inside <- startsWith(root_compare, paste0(workspace_compare, '/')) & root_compare != workspace_compare; if (!all(inside)) stop('Cleanup output roots must be distinct directories inside the Make workspace: ', paste(names(roots)[!inside], collapse = ', '), call. = FALSE); if (anyDuplicated(root_compare)) stop('Cleanup output roots must resolve to distinct directories.', call. = FALSE); targets <- unique(file.path(roots, model)); existing <- targets[file.exists(targets)]; statuses <- vapply(targets, unlink, integer(1), recursive = TRUE, force = TRUE); remaining <- targets[file.exists(targets)]; if (any(statuses != 0L) || length(remaining)) stop('Cleanup incomplete. Close open output files and ensure no pipeline is running. Paths not removed:\n  - ', paste(remaining, collapse = '\n  - '), call. = FALSE); pruned <- character(); for (root in roots[names(roots) != 'data']) if (dir.exists(root) && !length(list.files(root, all.files = TRUE, no.. = TRUE))) { root_status <- unlink(root, recursive = TRUE, force = TRUE); if (root_status != 0L || dir.exists(root)) stop('Could not remove empty output root: ', root, call. = FALSE); pruned <- c(pruned, root) }; if (length(existing)) cat('Removed package outputs:\n  - ', paste(existing, collapse = '\n  - '), '\n', sep = '') else cat('No package outputs were present for: ', model, '\n', sep = ''); if (length(pruned)) cat('Removed empty output roots:\n  - ', paste(pruned, collapse = '\n  - '), '\n', sep = ''); cat('Preserved user input root: ', roots[['data']], '\n', sep = '')" "$(MODEL)" "$(CURDIR)" "$(DATA_DIR)" "$(RDATA_DIR)" "$(STEP6)" "$(LOGS_DIR)" "$(FIGURES_DIR)" "$(RESULTS_DIR)"
	@echo "Cleanup completed for: $(MODEL)"
endif

# =================================================================================================================================
# Report pipeline status
# =================================================================================================================================
status:
	@echo "===== Pipeline Status ====="
	@Rscript -e "paths <- commandArgs(trailingOnly = TRUE); cat(if (all(file.exists(paths))) '[OK] Step 1: preprocessingMinfiEwasWater done\n' else '[MISSING] Step 1: preprocessingMinfiEwasWater output\n')" "$(RDATA_DIR)/$(MODEL)/$(STEP1)/$(METRICS_DIR)/beta_NomFilt_MSetF_Flt_Rxy_Ds_Rc.RData"
	@Rscript -e "paths <- commandArgs(trailingOnly = TRUE); cat(if (all(file.exists(paths))) '[OK] Step 2: SVA done\n' else '[MISSING] Step 2: SVA output\n')" "$(SVA_MARKER)" "$(PHENO_LC)"
	@Rscript -e "paths <- commandArgs(trailingOnly = TRUE); cat(if (all(file.exists(paths))) '[OK] Step 3: preprocessingPheno done\n' else '[MISSING] Step 3: preprocessingPheno output\n')" "$(COMBINED_PHENO_TARGET)"
	@Rscript -e "paths <- commandArgs(trailingOnly = TRUE); cat(if (all(file.exists(paths))) '[OK] Step 4: methylationGLM done\n' else '[MISSING] Step 4: methylationGLM output\n')" "$(GLM_WORKBOOK)" "$(GLM_REPORT_ASSET_DIR)/annotatedGLM.tsv.gz"
	@Rscript -e "paths <- commandArgs(trailingOnly = TRUE); cat(if (all(file.exists(paths))) '[OK] Step 5: methylationLME done\n' else '[MISSING] Step 5: methylationLME output\n')" "$(LME_WORKBOOK)" "$(LME_REPORT_ASSET_DIR)/annotatedLME.tsv.gz"
	@Rscript -e "paths <- commandArgs(trailingOnly = TRUE); cat(if (all(file.exists(paths))) '[OK] Step 6: Report generated\n' else '[MISSING] Step 6: Report output\n')" "$(STEP6)/$(MODEL)/docs/index.html"
	@echo "============================"

.PHONY: all clean clean_models status models step1 step2 step3 f3 f4 f3lme \
	 f3_models f4_models f3lme_models report-f3 report-f4 report-f3lme report-all \
	validate-glm-config validate-lme-config FORCE

FORCE:

